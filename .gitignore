# Re-include the examples tree. The bare `graphics` / `releases` /
# `testing` rules above were written when those names only meant
# generated artefacts; under examples/<name>/ they are part of the
# committed project layout. Per-example .gitignore files exclude the
# actual build outputs.
!examples/
!examples/**
# Re-include the CLI's embed template — `//go:embed graphics/...` in
# cmd/gdnext/internal/project/project.go must compile on a fresh
# checkout, so the template files (including the .godot/ stub) must be
# tracked.
!cmd/gdnext/internal/project/graphics/
!cmd/gdnext/internal/project/graphics/**
# Stray binaries from `go build .` at the repo root.
/cli-gdnext
/gdnext-ci
