--- !tapi-tbd
tbd-version:  4
install-name: '/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation'  # expected location for the implementation on IOS
targets:
 - arm64-ios
exports:
 - targets: [ arm64-ios ]
   symbols: # the required symbols to link libgodot (referenced via MoltenVK::useIOSurface and friends)
    - _kCFBooleanTrue
    - _kCFBooleanFalse
...
