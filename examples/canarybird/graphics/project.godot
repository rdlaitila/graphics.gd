; Engine configuration file.
; Hand-written for the canarybird CI example — kept minimal so a maintainer
; can read it end-to-end. Other example projects can copy this file as a
; starting point.

config_version=5

[application]
config/name="canarybird"
config/description="graphics.gd CI canary: a flappy-bird-style game touching every subsystem we build for."
run/main_scene="res://main.tscn"
run/main_loop_type="GoMainLoop"

[input]

; Single `flap` action driving the bird. Bound to space (keyboard), the
; left mouse button (touch on mobile), and the gamepad A button so the
; game responds the same way on every host the runners may emulate.
flap={
"deadzone": 0.5,
"events": [
Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null),
Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null),
Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

; Compatibility renderer keeps the canary buildable for the Web + Quest +
; mobile + desktop targets the CI matrix exercises.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

; Sky-blue clear colour so the player can tell the camera is up.
environment/defaults/default_clear_color=Color(0.45, 0.7, 0.95, 1)
