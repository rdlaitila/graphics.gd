# Per-example .gitignore — examples/ as a whole is force-included by
# the repo-root .gitignore, so build artefacts have to be excluded
# explicitly here.

# Test binary produced by `go test -c` or `gdnext test`.
/canarybird
/canarybird.exe

# `gdnext build` output.
/releases/

# Files gdnext + Godot auto-generate inside graphics/ on every build.
# The committed tree includes project.godot, main.tscn, and
# export_presets.cfg (the last is committed so CI builds use the same
# preset names + export paths as a local `gdnext build`); everything
# else is regenerated by `gdnext run` / `gdnext build`.
/graphics/.godot/
/graphics/.gitignore
/graphics/library.gdextension
/graphics/library.gdextension.uid
/graphics/library_documentation.xml
/graphics/*.so
/graphics/*.dll
/graphics/*.dylib
/graphics/*.a
/graphics/*.exe
/graphics/*.wasm
/graphics/*.xcframework
/graphics/musl_*.editor
